# HTTPS URL users enter to reach Start. Terminate TLS in your reverse proxy.
STARTPAGE_BASE_URL=https://start.example.com

# OpenID Connect provider and registered client.
STARTPAGE_OIDC_ISSUER=https://auth.example.com
STARTPAGE_OIDC_CLIENT_ID=start

# Optional browser-visible RP-initiated logout endpoint.
STARTPAGE_OIDC_LOGOUT_URL=https://auth.example.com/logout

# Comma-separated identity groups that receive system administration.
STARTPAGE_ADMIN_GROUPS=start-admins

# The quick start binds to loopback by default for a local reverse proxy.
START_BIND_ADDRESS=127.0.0.1
START_PORT=8080
