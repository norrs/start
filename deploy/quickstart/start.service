[Unit]
Description=Start internal link dashboard
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/start
ExecStart=/usr/bin/docker compose up --detach --remove-orphans
ExecReload=/usr/bin/docker compose pull
ExecReload=/usr/bin/docker compose up --detach --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
