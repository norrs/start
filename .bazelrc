common --enable_bzlmod
common --announce_rc
build --show_timestamps
build --enable_platform_specific_config
test --test_output=errors
test:e2e-headed --nocache_test_results
test:e2e-headed --test_env=DISPLAY
test:e2e-headed --test_env=XAUTHORITY
test:e2e-headed --test_env=START_E2E_HEADED=true
test:e2e-headed --test_env=START_E2E_SLOW_MO=100
test:e2e-headed --test_output=streamed
test:e2e-ui --nocache_test_results
test:e2e-ui --test_arg=--ui
test:e2e-ui --test_env=DISPLAY
test:e2e-ui --test_env=XAUTHORITY
test:e2e-ui --test_env=START_E2E_REUSE_SERVER=true
test:e2e-ui --test_output=streamed
test:e2e-ui --test_timeout=0
test:e2e-record --nocache_test_results
test:e2e-record --test_env=START_E2E_RECORD_ALL=true
test:e2e-record --test_env=START_E2E_SLOW_MO=500
build:release --stamp
build:release --compilation_mode=opt
