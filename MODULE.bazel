module(
    name = "start",
    version = "0.1.0",
)

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_alexedwards_scs_v2",
    "com_github_coreos_go_oidc_v3",
    "com_github_gin_gonic_gin",
    "com_github_google_uuid",
    "com_github_pressly_goose_v3",
    "com_github_prometheus_client_golang",
    "org_golang_x_oauth2",
    "in_gopkg_yaml_v3",
    "org_modernc_sqlite",
)

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//web:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.gitignore",
)
use_repo(npm, "npm")

playwright_browsers_repository = use_repo_rule("//tools/playwright:repositories.bzl", "playwright_browsers_repository")
playwright_browsers_repository(name = "playwright_browsers")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "start_distroless_static",
    digest = "sha256:c3c3d0230d487c0ad3a0d87ad03ee02ea2ff0b3dcce91ca06a1019e07de05f12",
    image = "gcr.io/distroless/static",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
)
use_repo(
    oci,
    "start_distroless_static",
    "start_distroless_static_linux_amd64",
    "start_distroless_static_linux_arm64",
)
